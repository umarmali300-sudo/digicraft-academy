# Copy to .env and fill in only the services you are actually using.
# Never commit .env. The app does not put these values in frontend code.

NEXORA_SECRET_KEY=
NEXORA_DATABASE_PATH=
NEXORA_BASE_URL=http://127.0.0.1:8000
NEXORA_COOKIE_SECURE=0
NEXORA_DEV_LOG_EMAILS=1
NEXORA_EMAIL_LOG=
NEXORA_FORM_MIN_SECONDS=2
NEXORA_ADMIN_EMAILS=
NEXORA_TRUST_PROXY=0

# Google OAuth. Redirect URI must match the Google Cloud console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# SMTP for verification and password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Optional direct contact channels. Leave blank to mark them as needing setup.
NEXORA_WHATSAPP_NUMBER=
NEXORA_TELEGRAM_USERNAME=
NEXORA_CONTACT_EMAIL=
NEXORA_ZOOM_URL=
NEXORA_MEET_URL=

# Both values are required before Stripe checkout is offered.
# Payments are marked complete only by a verified webhook, not by the return URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private MEGA storage for lesson PDFs and videos (needs Node.js and `npm install megajs@1.3.10`).
# Use a dedicated MEGA account. Never commit these values.
MEGA_EMAIL=
MEGA_PASSWORD=
# Optional: full path to node if it is not on PATH.
NEXORA_NODE_BIN=
